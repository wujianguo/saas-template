{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "outDir": "dist",
    "baseUrl": "src",
    "strictNullChecks": true,
    "types": ["node", "jest"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
