{
  "name": "@workspace/jest-config",
  "version": "0.0.0",
  "private": true,
  "license": "PROPRIETARY",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/entry.js",
  "types": "./dist/entry.d.ts",
  "exports": {
    ".": {
      "import": "./dist/entry.js",
      "require": "./dist/entry.js",
      "types": "./dist/entry.d.ts"
    },
    "./base": {
      "import": "./dist/base.js",
      "require": "./dist/base.js",
      "types": "./dist/base.d.ts"
    },
    "./nest": {
      "import": "./dist/nest.js",
      "require": "./dist/nest.js",
      "types": "./dist/nest.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "typescript": "^5.9.3",
    "@workspace/eslint-config": "workspace:*",
    "@types/node": "^25.1.0"
  }
}
